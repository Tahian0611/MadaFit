{% extends 'base.html.twig' %}

{% block title %}User index{% endblock %}

{% block body %}
    <h1>User index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Password</th>
                <th>MemberId</th>
                <th>RfidCard</th>
                <th>Photo</th>
                <th>FirstName</th>
                <th>LastName</th>
                <th>Phone</th>
                <th>Dob</th>
                <th>Gender</th>
                <th>Address</th>
                <th>EmergencyContact</th>
                <th>EmergencyPhone</th>
                <th>MedicalNotes</th>
                <th>JoinDate</th>
                <th>Subscription</th>
                <th>Status</th>
                <th>ExpiryDate</th>
                <th>StartDate</th>
                <th>Coach</th>
                <th>Program</th>
                <th>TotalPayments</th>
                <th>LastVisit</th>
                <th>VisitCount</th>
                <th>InGym</th>
                <th>Notes</th>
                <th>Activity</th>
                <th>AccessType</th>
                <th>CardStatus</th>
                <th>Promotion</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
                <td>{{ user.password }}</td>
                <td>{{ user.memberId }}</td>
                <td>{{ user.rfidCard }}</td>
                <td>{{ user.photo }}</td>
                <td>{{ user.firstName }}</td>
                <td>{{ user.lastName }}</td>
                <td>{{ user.phone }}</td>
                <td>{{ user.dob ? user.dob|date('Y-m-d') : '' }}</td>
                <td>{{ user.gender }}</td>
                <td>{{ user.address }}</td>
                <td>{{ user.emergencyContact }}</td>
                <td>{{ user.emergencyPhone }}</td>
                <td>{{ user.medicalNotes }}</td>
                <td>{{ user.joinDate ? user.joinDate|date('Y-m-d') : '' }}</td>
                <td>{{ user.subscription }}</td>
                <td>{{ user.status }}</td>
                <td>{{ user.expiryDate ? user.expiryDate|date('Y-m-d') : '' }}</td>
                <td>{{ user.startDate ? user.startDate|date('Y-m-d') : '' }}</td>
                <td>{{ user.coach }}</td>
                <td>{{ user.program }}</td>
                <td>{{ user.totalPayments }}</td>
                <td>{{ user.lastVisit ? user.lastVisit|date('Y-m-d') : '' }}</td>
                <td>{{ user.visitCount }}</td>
                <td>{{ user.inGym ? 'Yes' : 'No' }}</td>
                <td>{{ user.notes }}</td>
                <td>{{ user.activity }}</td>
                <td>{{ user.accessType }}</td>
                <td>{{ user.cardStatus }}</td>
                <td>{{ user.promotion }}</td>
                <td>
                    <a href="{{ path('app_user_show', {'id': user.id}) }}">show</a>
                    <a href="{{ path('app_user_edit', {'id': user.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="33">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_user_new') }}">Create new</a>
{% endblock %}
